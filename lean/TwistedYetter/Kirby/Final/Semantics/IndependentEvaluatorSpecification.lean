import TwistedYetter.Kirby.Final.Semantics.IndependentAlgebraicInput
import Mathlib.Algebra.BigOperators.Field
import Mathlib.Data.Fintype.BigOperators

/-!
# Independent human specification of the role-aware evaluator

This file is normative.  It was written from the human formula and Tham,
Definition 5.11, without importing or inspecting this repository's evaluator,
Sage implementation, compatibility bridge, or numerical artifacts.

Reference:

* Ying Hong Tham, *On the Category of Boundary Values in the extended
  Crane-Yetter TQFT* (2021), Definition 5.11, thesis page 52 (PDF page 58).

Tham's convention is

`D = ∑ i : Irr(𝒞), dᵢ²`.

His elementary handle maps are:

* index 0: multiply by `D`;
* index 1: multiply by `D⁻¹`;
* index 2: insert the regular colour `∑ i, dᵢ i`;
* index 3: cut across the co-core and retain only the tensor-unit summand;
* index 4: apply the Reshetikhin--Turaev evaluation in `S³`.

For a primal special Kirby presentation read by the dual handle
decomposition, primal handles of indices `4,3,2,1,0` therefore use Tham's
maps of indices `0,1,2,3,4`, respectively.  In particular, a dotted primal
1-handle is a unit-only cut.  It is not an ordinary Kirby-coloured component
and it is not a projector onto all transparent objects.

This file pins the mathematical recipe.  It intentionally does not claim
that the existing implementation realizes the recipe.
-/

namespace TwistedYetter.Kirby.Final.IndependentEvaluatorSpecification

open scoped BigOperators

universe uK uC uDiagram

/-- A strand meets an oriented dotted co-core with positive or negative sign. -/
inductive PunctureOrientation
  | positive
  | negative
  deriving DecidableEq, Repr

/-- One occurrence of an ordinary 2-handle strand in a dotted co-core. -/
structure OrientedPuncture (TwoHandle : Type) where
  component : TwoHandle
  orientation : PunctureOrientation
  deriving DecidableEq, Repr

/--
The handle-chain data belonging to a special Kirby presentation.

`C₂` is generated by ordinary framed components, `C₁` by dotted components,
and `C₃` by the primal 3-handles.  No global abbreviation such as `H₂ = ℤ`
is permitted.
-/
structure IntegralHandleChain (nOne nTwo nThree : ℕ) where
  boundaryTwo : (Fin nTwo → ℤ) →+ (Fin nOne → ℤ)
  boundaryThree : (Fin nThree → ℤ) →+ (Fin nTwo → ℤ)
  boundarySquared :
    boundaryTwo.comp boundaryThree = 0

namespace IntegralHandleChain

variable {nOne nTwo nThree : ℕ}

/-- An integral 2-cycle is literally an element of `ker ∂₂`. -/
def TwoCycle (chain : IntegralHandleChain nOne nTwo nThree) :=
  {a : Fin nTwo → ℤ // chain.boundaryTwo a = 0}

/-- Two cycles represent the same H₂ class exactly when they differ by `im ∂₃`. -/
def Homologous
    (chain : IntegralHandleChain nOne nTwo nThree)
    (a b : chain.TwoCycle) : Prop :=
  ∃ c : Fin nThree → ℤ, b.1 - a.1 = chain.boundaryThree c

end IntegralHandleChain

/--
Independent semantics of a special Kirby presentation.

`Diagram` is only the exterior framed ribbon diagram.  The role data below
are not inferred from it: ordinary and dotted components have different
mathematical meanings and are recorded separately.
-/
structure SpecialKirbyPresentationSemantics (Diagram : Type uDiagram) where
  nOne : ℕ
  nTwo : ℕ
  nThree : ℕ
  nFour : ℕ
  oneZeroHandle : nFour = 1
  exterior : Diagram
  framing : Fin nTwo → ℤ
  dottedPunctureWord :
    Fin nOne → List (OrientedPuncture (Fin nTwo))
  chain : IntegralHandleChain nOne nTwo nThree

namespace SpecialKirbyPresentationSemantics

variable {Diagram : Type uDiagram}

/-- A choice of a simple label on every ordinary 2-handle. -/
def OrdinaryLabelling
    (presentation : SpecialKirbyPresentationSemantics Diagram)
    (SimpleLabel : Type) :=
  Fin presentation.nTwo → SimpleLabel

end SpecialKirbyPresentationSemantics

/--
The scalar data used by the finite Kirby-colour expansion.

Tham's `D` is fixed here as `∑ᵢ dᵢ²`; no square root convention is hidden in
the name `categoryDimension`.
-/
structure EvaluatorDimensionSemantics
    (K : Type uK) [Field K]
    (SimpleLabel : Type) [Fintype SimpleLabel] where
  quantumDimension : SimpleLabel → K
  categoryDimension : K :=
    ∑ i, quantumDimension i * quantumDimension i
  categoryDimension_ne_zero : categoryDimension ≠ 0

/-- The character coupon placed on ordinary component `j` is `η^(a j)`. -/
structure CharacterCouponInstruction
    (TwoHandle SimpleLabel : Type) where
  component : TwoHandle
  label : SimpleLabel
  exponent : ℤ

/--
The local instruction at a dotted primal 1-handle.

The puncture word determines the oriented tensor word.  `retainTensorUnitOnly`
is deliberately a proposition with the unique allowed value `True`: there is
no constructor for an ordinary Kirby colour or a transparent-sector
projector at a dotted component.
-/
structure TensorUnitCutInstruction
    (OneHandle TwoHandle SimpleLabel : Type) where
  dottedComponent : OneHandle
  punctureWord : List (OrientedPuncture TwoHandle)
  labelOf : TwoHandle → SimpleLabel
  retainTensorUnitOnly : Prop := True
  retainTensorUnitOnly_proof : retainTensorUnitOnly

/--
A completely expanded summand before the final `S³` ribbon evaluation.

Every ordinary component has one simple label and one integral character
exponent.  Every dotted component has one unit-only cut.  The exterior
diagram is unchanged.
-/
structure ExpandedRoleAwareRibbonTerm
    (Diagram : Type uDiagram)
    (SimpleLabel : Type)
    (presentation : SpecialKirbyPresentationSemantics Diagram) where
  exterior : Diagram := presentation.exterior
  ordinaryLabel : Fin presentation.nTwo → SimpleLabel
  characterCoupon :
    Fin presentation.nTwo →
      CharacterCouponInstruction (Fin presentation.nTwo) SimpleLabel
  characterCoupon_component :
    (j : Fin presentation.nTwo) →
      (characterCoupon j).component = j
  characterCoupon_label :
    (j : Fin presentation.nTwo) →
      (characterCoupon j).label = ordinaryLabel j
  dottedCut :
    Fin presentation.nOne →
      TensorUnitCutInstruction
        (Fin presentation.nOne) (Fin presentation.nTwo) SimpleLabel
  dottedCut_component :
    (k : Fin presentation.nOne) →
      (dottedCut k).dottedComponent = k
  dottedCut_word :
    (k : Fin presentation.nOne) →
      (dottedCut k).punctureWord = presentation.dottedPunctureWord k
  dottedCut_labels :
    (k : Fin presentation.nOne) →
      (dottedCut k).labelOf = ordinaryLabel

/--
The one primitive graphical operation used by the formula.

For the supplied premodular category and character, this is the ordinary
ribbon graphical evaluation in `S³` of the fully expanded term.  The
character coupon on component `j` is interpreted as `η_(label j)^(a j)`;
each dotted instruction is interpreted as the projector onto the
tensor-unit summand of its oriented puncture tensor word.

This interface does not assert Kirby-move invariance or H₂ descent.
-/
structure ClosedRibbonGraphicalEvaluation
    (K : Type uK) [Field K]
    (Diagram : Type uDiagram)
    (SimpleLabel : Type)
    (presentation : SpecialKirbyPresentationSemantics Diagram) where
  evaluate :
    ExpandedRoleAwareRibbonTerm Diagram SimpleLabel presentation → K

section Formula

variable
    {K : Type uK} [Field K]
    {Diagram : Type uDiagram}
    {SimpleLabel : Type} [Fintype SimpleLabel] [DecidableEq SimpleLabel]

/-- Construct the exact expanded term belonging to one label assignment. -/
def expandedTerm
    (presentation : SpecialKirbyPresentationSemantics Diagram)
    (cycle : presentation.chain.TwoCycle)
    (label : presentation.OrdinaryLabelling SimpleLabel) :
    ExpandedRoleAwareRibbonTerm Diagram SimpleLabel presentation where
  ordinaryLabel := label
  characterCoupon := fun j =>
    { component := j
      label := label j
      exponent := cycle.1 j }
  characterCoupon_component := fun _ => rfl
  characterCoupon_label := fun _ => rfl
  dottedCut := fun k =>
    { dottedComponent := k
      punctureWord := presentation.dottedPunctureWord k
      labelOf := label
      retainTensorUnitOnly_proof := trivial }
  dottedCut_component := fun _ => rfl
  dottedCut_word := fun _ => rfl
  dottedCut_labels := fun _ => rfl

/--
The finite, character-twisted, role-aware numerator.

Only ordinary 2-handles are summed over simple labels and weighted by quantum
dimensions.  Dotted 1-handles are already represented by unit-only cuts in
`expandedTerm`.
-/
noncomputable def rawEvaluation
    (presentation : SpecialKirbyPresentationSemantics Diagram)
    (dimensions : EvaluatorDimensionSemantics K SimpleLabel)
    (graphical :
      ClosedRibbonGraphicalEvaluation K Diagram SimpleLabel presentation)
    (cycle : presentation.chain.TwoCycle) : K :=
  ∑ label : presentation.OrdinaryLabelling SimpleLabel,
    (∏ j, dimensions.quantumDimension (label j)) *
      graphical.evaluate (expandedTerm presentation cycle label)

/--
Tham Definition 5.11 read on the dual handle decomposition.

Primal 4-handles become index-0 maps and contribute `D`; primal 3-handles
become index-1 maps and contribute `D⁻¹`.  Hence the overall factor is
`D^(h₄-h₃)`.  For the special convention `h₄ = 1`, this is `D^(1-h₃)`.

The mirror/orientation identification needed to regard the final graph as a
graph in the boundary of the dual 4-handle belongs to `presentation.exterior`;
it is not silently changed by this scalar.
-/
noncomputable def dualHandleNormalization
    (presentation : SpecialKirbyPresentationSemantics Diagram)
    (dimensions : EvaluatorDimensionSemantics K SimpleLabel) : K :=
  dimensions.categoryDimension ^ presentation.nFour /
    dimensions.categoryDimension ^ presentation.nThree

/-- The cycle-level evaluator fixed by the independent human specification. -/
noncomputable def cycleEvaluation
    (presentation : SpecialKirbyPresentationSemantics Diagram)
    (dimensions : EvaluatorDimensionSemantics K SimpleLabel)
    (graphical :
      ClosedRibbonGraphicalEvaluation K Diagram SimpleLabel presentation)
    (cycle : presentation.chain.TwoCycle) : K :=
  dualHandleNormalization presentation dimensions *
    rawEvaluation presentation dimensions graphical cycle

/--
The exact remaining obligation before the cycle-level expression descends to
`H₂`: homologous handle 2-cycles must have equal evaluations.
-/
def RepresentativeIndependent
    (presentation : SpecialKirbyPresentationSemantics Diagram)
    (dimensions : EvaluatorDimensionSemantics K SimpleLabel)
    (graphical :
      ClosedRibbonGraphicalEvaluation K Diagram SimpleLabel presentation) :
    Prop :=
  ∀ a b : presentation.chain.TwoCycle,
    presentation.chain.Homologous a b →
      cycleEvaluation presentation dimensions graphical a =
        cycleEvaluation presentation dimensions graphical b

end Formula

end TwistedYetter.Kirby.Final.IndependentEvaluatorSpecification
