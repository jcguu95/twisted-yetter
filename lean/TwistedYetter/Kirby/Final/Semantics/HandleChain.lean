import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.Algebra.Homology.Homotopy
import Mathlib.Algebra.Homology.ShortComplex.Abelian
import TwistedYetter.Kirby.Presentation

/-!
# Independent handle-chain semantics

This file intentionally does not import the repository's Kirby-move,
cancellation, compiler, or invariance modules.  It provides only the handle
counts, an explicit integral handle-chain complex, and the map on second
homology induced by an actual chain homotopy equivalence.
-/

namespace TwistedYetter.Kirby.Final.SemanticHandleChain

open CategoryTheory
open CategoryTheory.Limits
open TwistedYetter.Kirby.Presentation

noncomputable section

/-- Numbers of handles of each index in the displayed decomposition. -/
structure HandleCounts where
  h0 : Nat
  h1 : Nat
  h2 : Nat
  h3 : Nat
  h4 : Nat
  deriving Repr, BEq, DecidableEq

namespace HandleCounts

/-- Add one cancelling primal 1--2 handle pair. -/
def addOneTwo (counts : HandleCounts) : HandleCounts :=
  { counts with h1 := counts.h1 + 1, h2 := counts.h2 + 1 }

/-- Add one cancelling primal 2--3 handle pair. -/
def addTwoThree (counts : HandleCounts) : HandleCounts :=
  { counts with h2 := counts.h2 + 1, h3 := counts.h3 + 1 }

/--
Turn a four-dimensional handle decomposition upside down.

This is the convention used by the THAM handle formula: primal 1-handles
become degree-three handles, primal 3-handles become degree-one handles, and
degree two is unchanged.
-/
def turnedOver (counts : HandleCounts) : HandleCounts where
  h0 := counts.h4
  h1 := counts.h3
  h2 := counts.h2
  h3 := counts.h1
  h4 := counts.h0

@[simp] theorem turnedOver_h0 (counts : HandleCounts) :
    counts.turnedOver.h0 = counts.h4 := rfl

@[simp] theorem turnedOver_h1 (counts : HandleCounts) :
    counts.turnedOver.h1 = counts.h3 := rfl

@[simp] theorem turnedOver_h2 (counts : HandleCounts) :
    counts.turnedOver.h2 = counts.h2 := rfl

@[simp] theorem turnedOver_h3 (counts : HandleCounts) :
    counts.turnedOver.h3 = counts.h1 := rfl

@[simp] theorem turnedOver_h4 (counts : HandleCounts) :
    counts.turnedOver.h4 = counts.h0 := rfl

end HandleCounts

/-- The free integral module generated by `count` handles. -/
abbrev HandleModule (count : Nat) :=
  ModuleCat.of ℤ (Fin count → ℤ)

/--
An integral chain complex with explicit bases indexed by the handles.

The hashes bind the complex, boundary matrices, and bases to independently
auditable artifacts.  They are provenance fields, not substitutes for the
actual complex and basis isomorphisms.
-/
structure HandleChainModel (counts : HandleCounts) where
  complex : ChainComplex (ModuleCat ℤ) ℕ
  degreeZeroBasis : complex.X 0 ≅ HandleModule counts.h0
  degreeOneBasis : complex.X 1 ≅ HandleModule counts.h1
  degreeTwoBasis : complex.X 2 ≅ HandleModule counts.h2
  degreeThreeBasis : complex.X 3 ≅ HandleModule counts.h3
  degreeFourBasis : complex.X 4 ≅ HandleModule counts.h4
  higherDegreeZero :
    (degree : Nat) → 5 ≤ degree → IsZero (complex.X degree)
  chainSnapshotHash : String
  chain_snapshot_hash_shape :
    RawPresentation.sha256Shape chainSnapshotHash = true
  boundaryMatrixCertificateHash : String
  boundary_matrix_certificate_hash_shape :
    RawPresentation.sha256Shape boundaryMatrixCertificateHash = true
  basisCertificateHash : String
  basis_certificate_hash_shape :
    RawPresentation.sha256Shape basisCertificateHash = true

namespace HandleChainModel

/-- Second homology of this exact chain complex. -/
abbrev SecondHomology {counts : HandleCounts}
    (model : HandleChainModel counts) :=
  model.complex.homology 2

end HandleChainModel

/--
Actual chain-level equivalence between two handle-chain complexes.

There is no separately supplied map on homology; it is derived below.
-/
structure HandleChainEquivalence
    {sourceCounts targetCounts : HandleCounts}
    (source : HandleChainModel sourceCounts)
    (target : HandleChainModel targetCounts) where
  homotopyEquiv : HomotopyEquiv source.complex target.complex
  chainMapSnapshotHash : String
  chain_map_snapshot_hash_shape :
    RawPresentation.sha256Shape chainMapSnapshotHash = true
  sourceChainHash : String
  source_chain_hash_sound :
    sourceChainHash = source.chainSnapshotHash
  targetChainHash : String
  target_chain_hash_sound :
    targetChainHash = target.chainSnapshotHash

namespace HandleChainEquivalence

/-- The additive equivalence on `H₂` forced by the chain equivalence. -/
noncomputable def secondHomologyAddEquiv
    {sourceCounts targetCounts : HandleCounts}
    {source : HandleChainModel sourceCounts}
    {target : HandleChainModel targetCounts}
    (equivalence : HandleChainEquivalence source target) :
    source.SecondHomology ≃+ target.SecondHomology :=
  (equivalence.homotopyEquiv.toHomologyIso 2).toLinearEquiv.toAddEquiv

end HandleChainEquivalence

end

end TwistedYetter.Kirby.Final.SemanticHandleChain
