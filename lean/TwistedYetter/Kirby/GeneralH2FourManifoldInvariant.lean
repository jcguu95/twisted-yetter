import TwistedYetter.Kirby.CanonicalRawLocalMoveTarget
import TwistedYetter.Kirby.CancellationSafeH2Transport
import TwistedYetter.Kirby.GeneralH2MarkedKirbyInvariance
import TwistedYetter.Kirby.LiteratureBackedFourManifoldTopology

/-!
# Four-manifold descent for the arbitrary-H2 modular evaluator

Status: alternative implementation route retained for comparison.  This is
not the public theorem entry point.  See
`Kirby.Final.ModularClosedFourManifoldInvariant`.

This module assembles the paper-facing descent theorem without a
simply-connected or finite-free hypothesis.

The remaining mathematical inputs are visible in the theorem signature:

* a graphical compiler producing the restricted `LocalCycleCalculation` for
  each of the eight source-bound moves; and
* the category-free realization, move soundness, presentation existence, and
  marked Kirby--Cerf completeness data.

Neither input may contain an equality of scalar evaluations.  Lean proves
local evaluator invariance, quotient descent, oriented-diffeomorphism
invariance, and agreement with every displayed presentation formula.
-/

namespace TwistedYetter.Kirby.GeneralH2FourManifoldInvariant

open CategoryTheory
open TwistedYetter.Fusion.EGNO
open TwistedYetter.Kirby.CancellationSafeH2Representative
open TwistedYetter.Kirby.CanonicalRawLocalMoveTarget
open TwistedYetter.Kirby.GeneralH2MarkedKirbyInvariance
open TwistedYetter.Kirby.KirbyCompleteness
open TwistedYetter.Kirby.LiteratureBackedFourManifoldTopology
open TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget
open TwistedYetter.Kirby.SourceBackedKirbyCompleteness

universe uK uC vC uH uX uXHom

variable {K : Type uK} [Field K] [IsAlgClosed K] [CharZero K]
variable {C : Type uC} [Category.{vC} C] [Abelian C]
variable [CategoryTheory.Linear K C]
variable [MonoidalCategory C] [RigidCategory C] [BraidedCategory C]
variable [MonoidalPreadditive C] [MonoidalLinear K C]
variable {S : Type} [Fintype S] [DecidableEq S]

/--
One exact source-bound topology move together with compatible representatives.

The graphical calculation is generated by `completion`; it is not an
independent field and cannot be replaced by an assumed scalar equality.
-/
structure CanonicalMarkedMove
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    {manifold : ClosedConnectedSmoothOrientedFourManifoldInput}
    {H2 : Type uH} [AddCommGroup H2]
    {alpha : H2}
    (source target : AdmissiblePresentation manifold H2 alpha) where
  topologyMove :
    TopologicalTableTwoMove
      source.state.presentation.topology
      target.state.presentation.topology
  compatibility :
    CancellationSafeStep
      (localCycleCalculation_of_completion completion topologyMove)
      source.state.representative target.state.representative

/--
The canonical arbitrary-H2 presentation calculus generated by exact raw
topology moves and the supplied graphical compiler.
-/
noncomputable def canonicalMarkedPresentationTheory
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    HandlePresentationTheory where
  Presentation := AdmissiblePresentation manifold H2 alpha
  Marking := fun _ => PUnit
  ElementaryMove := fun source target =>
    CanonicalMarkedMove 𝒞 automorphism completion source target
  transport := fun _ _ => PUnit.unit

/-- Scalar evaluation on one canonical arbitrary-H2 marked presentation. -/
noncomputable def canonicalMarkedEvaluation
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    PresentationEvaluation
      (canonicalMarkedPresentationTheory
        𝒞 automorphism completion manifold H2 alpha) K where
  value := fun presentation _ => presentation.value 𝒞 automorphism

/--
Every generated canonical move preserves the arbitrary-H2 evaluation.

This is proved from the generated local calculation and representative
compatibility.  No equality in `K` is stored in `CanonicalMarkedMove`.
-/
theorem canonicalMarkedEvaluation_localInvariant
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    IsInvariantUnderElementaryMoves
      (canonicalMarkedEvaluation
        𝒞 automorphism completion manifold H2 alpha) := by
  intro source target move _
  exact eval_sound
    (localCycleCalculation_of_completion completion move.topologyMove)
    source.state.representative target.state.representative
    move.compatibility

/-- Evaluation on canonical marked Kirby classes. -/
noncomputable def evaluationOnCanonicalKirbyClass
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    (canonicalMarkedPresentationTheory
      𝒞 automorphism completion manifold H2 alpha).KirbyClass → K :=
  (canonicalMarkedEvaluation
    𝒞 automorphism completion manifold H2 alpha).descendToKirbyClass
      (canonicalMarkedEvaluation_localInvariant
        𝒞 automorphism completion manifold H2 alpha)

/--
The category-free topology input needed to identify the generated quotient
with marked closed oriented smooth four-manifolds.
-/
abbrev TopologyInput
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :=
  FourManifoldTopologyBoundary.{_, _, _, uX, uXHom}
    (canonicalMarkedPresentationTheory
      𝒞 automorphism completion manifold H2 alpha)

/--
The resulting scalar on marked closed oriented smooth four-manifolds.
-/
noncomputable def EvalC
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2)
    (topology :
      TopologyInput.{uK, uC, vC, uH, uX, uXHom}
        𝒞 automorphism completion manifold H2 alpha) :
    topology.realization.MarkedClosedOrientedSmoothFourManifold → K :=
  topology.fourManifoldInvariant
    (canonicalMarkedEvaluation
      𝒞 automorphism completion manifold H2 alpha)
    (canonicalMarkedEvaluation_localInvariant
      𝒞 automorphism completion manifold H2 alpha)

/-- `EvalC` is constant under every oriented diffeomorphism. -/
theorem EvalC_diffeomorphism_invariant
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2)
    (topology :
      TopologyInput.{uK, uC, vC, uH, uX, uXHom}
        𝒞 automorphism completion manifold H2 alpha)
    {left right :
      topology.realization.MarkedClosedOrientedSmoothFourManifold}
    (diffeomorphism :
      topology.realization.orientedDiffeomorphism.Hom left right) :
    EvalC 𝒞 automorphism completion manifold H2 alpha topology left =
      EvalC 𝒞 automorphism completion manifold H2 alpha topology right :=
  topology.fourManifoldInvariant_diffeomorphism_invariant
    (canonicalMarkedEvaluation
      𝒞 automorphism completion manifold H2 alpha)
    (canonicalMarkedEvaluation_localInvariant
      𝒞 automorphism completion manifold H2 alpha)
    diffeomorphism

/-- Pulling `EvalC` back to a presentation gives the explicit formula. -/
theorem EvalC_on_presentation
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (completion : Completion 𝒞 automorphism)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2)
    (topology :
      TopologyInput.{uK, uC, vC, uH, uX, uXHom}
        𝒞 automorphism completion manifold H2 alpha)
    (presentation : AdmissiblePresentation manifold H2 alpha) :
    EvalC 𝒞 automorphism completion manifold H2 alpha topology
        (topology.realization.realize
          {
            presentation := presentation
            marking := PUnit.unit
          }) =
      presentation.value 𝒞 automorphism := by
  exact topology.fourManifoldInvariant_on_presentation
    (canonicalMarkedEvaluation
      𝒞 automorphism completion manifold H2 alpha)
    (canonicalMarkedEvaluation_localInvariant
      𝒞 automorphism completion manifold H2 alpha)
    {
      presentation := presentation
      marking := PUnit.unit
    }

end TwistedYetter.Kirby.GeneralH2FourManifoldInvariant
