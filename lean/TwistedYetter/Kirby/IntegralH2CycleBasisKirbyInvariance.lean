import TwistedYetter.Kirby.CancellationSafeH2Representative
import TwistedYetter.Kirby.IntegralH2CycleBasis
import TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget

/-!
# Kirby invariance for integral cycle-basis markings

This is the generalized integral local theorem.  It no longer requires the
homology basis to be a subset of individual two-handles.

The price is explicit and unavoidable.  Across each move, topology must prove
that the chosen target marked cycle is literally the cycle produced by the
handle-chain map, and a cancellation death must prove that the source marked
cycle is cancellation-safe.  These are geometric statements; neither stores
an equality of scalar evaluations.

Consequently this module establishes a genuine invariant on the quotient
generated by certified integral-cycle-basis moves.  It does not yet assert
that all presentations of every closed four-manifold lie in one such
quotient component.
-/

namespace TwistedYetter.Kirby.IntegralH2CycleBasisKirbyInvariance

open CategoryTheory
open TwistedYetter.Fusion.EGNO
open TwistedYetter.Kirby.CancellationSafeH2Representative
open TwistedYetter.Kirby.CanonicalCycleLocalInvariance
open TwistedYetter.Kirby.CanonicalModularKirbyEvaluator
open TwistedYetter.Kirby.IntegralH2
open TwistedYetter.Kirby.KirbyCompleteness
open TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget

universe uK uC vC uH

variable {K : Type uK} [Field K] [IsAlgClosed K] [CharZero K]
variable {C : Type uC} [Category.{vC} C] [Abelian C]
variable [CategoryTheory.Linear K C]
variable [MonoidalCategory C] [RigidCategory C] [BraidedCategory C]
variable [MonoidalPreadditive C] [MonoidalLinear K C]
variable {S : Type} [Fintype S] [DecidableEq S]

/-- Evaluate an `H₂` class using one explicit integral cycle basis. -/
noncomputable def integralCycleBasisPresentationValue
    {H2 : Type uH} [AddCommGroup H2]
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (presentation : CanonicalPresentation H2)
    (basis : CycleBasis presentation)
    (alpha : presentation.topology.handleChain.SecondHomology) : K :=
  presentation.rawCycleColourEval
    𝒞 automorphism (basis.markedCycle alpha)

/-- Literal equality of marked cycles makes basis choice immaterial. -/
theorem integralCycleBasisPresentationValue_eq_of_strictComparison
    {H2 : Type uH} [AddCommGroup H2]
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (presentation : CanonicalPresentation H2)
    (left right : CycleBasis presentation)
    (comparison : CycleBasis.StrictComparison left right)
    (alpha : presentation.topology.handleChain.SecondHomology) :
    integralCycleBasisPresentationValue
        𝒞 automorphism presentation left alpha =
      integralCycleBasisPresentationValue
        𝒞 automorphism presentation right alpha := by
  unfold integralCycleBasisPresentationValue
  rw [comparison.marked_cycle_eq]

/--
Every unimodular integral change of basis leaves the presentation value
unchanged.

This theorem does not compare arbitrary cycle lifts.  `CycleBasis.rebase`
changes coordinates and basis vectors together so that the actual marked
degree-two cycle is literally unchanged.
-/
theorem integralCycleBasisPresentationValue_rebase
    {H2 : Type uH} [AddCommGroup H2]
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (presentation : CanonicalPresentation H2)
    (basis : CycleBasis presentation)
    (change :
      (Fin basis.rank → ℤ) ≃ₗ[ℤ] (Fin basis.rank → ℤ))
    (alpha : presentation.topology.handleChain.SecondHomology) :
    integralCycleBasisPresentationValue
        𝒞 automorphism presentation (basis.rebase change) alpha =
      integralCycleBasisPresentationValue
        𝒞 automorphism presentation basis alpha :=
  integralCycleBasisPresentationValue_eq_of_strictComparison
    𝒞 automorphism presentation (basis.rebase change) basis
      (basis.rebaseStrictComparison change) alpha

/--
Topology-only compatibility of integral cycle bases across one local move.

There is no field in `K` and no field asserting evaluator equality.
-/
structure IntegralCycleBasisMoveCompatibility
    {H2 : Type uH} [AddCommGroup H2]
    {𝒞 : ModularCategory (K := K) (C := C) (S := S)}
    {automorphism : TensorIdentityAutomorphism C}
    {source target : CanonicalPresentation H2}
    {move : TableTwoMove source.topology target.topology}
    (calculation : LocalCycleCalculation 𝒞 automorphism move)
    (sourceBasis : CycleBasis source)
    (targetBasis : CycleBasis target) where
  marked_cycle_transport :
    (alpha : source.topology.handleChain.SecondHomology) →
      targetBasis.markedCycle
          ((markedTransport calculation).chainEquivalence
            |>.secondHomologyAddEquiv alpha) =
        targetCycle calculation (sourceBasis.markedCycle alpha)
  cancellation_safe :
    (alpha : source.topology.handleChain.SecondHomology) →
      IsCancellationSafe calculation (sourceBasis.markedCycle alpha)

namespace IntegralCycleBasisMoveCompatibility

/-- One certified local move preserves the generalized integral value. -/
theorem presentationValue_eq
    {H2 : Type uH} [AddCommGroup H2]
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    {source target : CanonicalPresentation H2}
    {move : TableTwoMove source.topology target.topology}
    (calculation : LocalCycleCalculation 𝒞 automorphism move)
    (sourceBasis : CycleBasis source)
    (targetBasis : CycleBasis target)
    (compatibility :
      IntegralCycleBasisMoveCompatibility
        calculation sourceBasis targetBasis)
    (alpha : source.topology.handleChain.SecondHomology) :
    integralCycleBasisPresentationValue
        𝒞 automorphism source sourceBasis alpha =
      integralCycleBasisPresentationValue
        𝒞 automorphism target targetBasis
          ((markedTransport calculation).chainEquivalence
            |>.secondHomologyAddEquiv alpha) := by
  unfold integralCycleBasisPresentationValue
  rw [compatibility.marked_cycle_transport]
  exact cycleEvalC_sound calculation
    (sourceBasis.markedCycle alpha)
    (compatibility.cancellation_safe alpha)

end IntegralCycleBasisMoveCompatibility

/-- One canonical presentation with a finite-free integral cycle basis. -/
structure IntegralCycleBasisPresentation
    (H2 : Type uH) [AddCommGroup H2] where
  presentation : CanonicalPresentation H2
  basis : CycleBasis presentation

/--
One local move carrying both the graphical calculation and the topology-only
integral basis compatibility proof.
-/
structure IntegralCycleBasisMove
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    {H2 : Type uH} [AddCommGroup H2]
    (source target : IntegralCycleBasisPresentation H2) where
  move :
    TableTwoMove
      source.presentation.topology target.presentation.topology
  calculation :
    LocalCycleCalculation 𝒞 automorphism move
  compatibility :
    IntegralCycleBasisMoveCompatibility
      calculation source.basis target.basis

/-- Presentation calculus generated by certified integral-basis moves. -/
noncomputable def integralCycleBasisPresentationTheory
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (H2 : Type uH) [AddCommGroup H2] :
    HandlePresentationTheory where
  Presentation := IntegralCycleBasisPresentation H2
  Marking := fun marked =>
    marked.presentation.topology.handleChain.SecondHomology
  ElementaryMove := fun source target =>
    IntegralCycleBasisMove 𝒞 automorphism source target
  transport := fun move =>
    (markedTransport move.calculation).chainEquivalence
      |>.secondHomologyAddEquiv

/-- Scalar evaluation on the generalized integral presentation calculus. -/
noncomputable def integralCycleBasisEvaluation
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (H2 : Type uH) [AddCommGroup H2] :
    PresentationEvaluation
      (integralCycleBasisPresentationTheory
        𝒞 automorphism H2) K where
  value := fun marked alpha =>
    integralCycleBasisPresentationValue
      𝒞 automorphism marked.presentation marked.basis alpha

/-- The generalized integral evaluator preserves every admitted local move. -/
theorem integralCycleBasisEvaluation_localInvariant
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (H2 : Type uH) [AddCommGroup H2] :
    IsInvariantUnderElementaryMoves
      (integralCycleBasisEvaluation
        𝒞 automorphism H2) := by
  intro source target move alpha
  exact move.compatibility.presentationValue_eq
    𝒞 automorphism move.calculation source.basis target.basis alpha

/-- The value on the certified integral-cycle-basis Kirby quotient. -/
noncomputable def integralCycleBasisEvaluationOnKirbyClass
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (H2 : Type uH) [AddCommGroup H2] :
    (integralCycleBasisPresentationTheory
      𝒞 automorphism H2).KirbyClass → K :=
  (integralCycleBasisEvaluation
    𝒞 automorphism H2).descendToKirbyClass
      (integralCycleBasisEvaluation_localInvariant
        𝒞 automorphism H2)

/-- Quotient evaluation agrees with the explicit presentation formula. -/
theorem integralCycleBasisEvaluationOnKirbyClass_mk
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (H2 : Type uH) [AddCommGroup H2]
    (marked :
      (integralCycleBasisPresentationTheory
        𝒞 automorphism H2).MarkedPresentation) :
    integralCycleBasisEvaluationOnKirbyClass
        𝒞 automorphism H2 (Quotient.mk _ marked) =
      (integralCycleBasisEvaluation
        𝒞 automorphism H2).markedValue marked :=
  rfl

end TwistedYetter.Kirby.IntegralH2CycleBasisKirbyInvariance
