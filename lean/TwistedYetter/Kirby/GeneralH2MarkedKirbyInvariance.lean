import TwistedYetter.Kirby.CancellationSafeH2Representative
import TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget

/-!
# Kirby invariance for arbitrary integral second homology

This module removes the finite-free hypothesis from the marked-presentation
calculus.  Its public marking is an element of an arbitrary additive
commutative group `H2`; in particular, torsion is allowed.

An internal presentation carries an actual degree-two cycle and a proof that
the cycle represents the requested class.  An elementary move carries the
restricted eight-case graphical calculation and the topology-only statement
that the target representative is the transported source representative and
that a cancellation death is safe.  It cannot store an equality of scalar
evaluations.

The result is an invariant on the quotient generated by these certified
marked moves.  The separate global topology problem is to prove that every
presentation of a fixed pair `(X, alpha)` lies in the required quotient
component.  Nothing in this file assumes that `H2` is free or that the
underlying four-manifold is simply connected.
-/

namespace TwistedYetter.Kirby.GeneralH2MarkedKirbyInvariance

open CategoryTheory
open TwistedYetter.Fusion.EGNO
open TwistedYetter.Kirby.CancellationSafeH2Representative
open TwistedYetter.Kirby.CanonicalCycleLocalInvariance
open TwistedYetter.Kirby.CanonicalModularKirbyEvaluator
open TwistedYetter.Kirby.KirbyCompleteness
open TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget

universe uK uC vC uH

variable {K : Type uK} [Field K] [IsAlgClosed K] [CharZero K]
variable {C : Type uC} [Category.{vC} C] [Abelian C]
variable [CategoryTheory.Linear K C]
variable [MonoidalCategory C] [RigidCategory C] [BraidedCategory C]
variable [MonoidalPreadditive C] [MonoidalLinear K C]
variable {S : Type} [Fintype S] [DecidableEq S]

/--
One certified move between two internal presentations of the same public
class `alpha : H2`.

The compatibility field is topology and representative data only.  The
scalar equality used below is proved by `eval_sound`; it is not an input.
-/
structure MarkedMove
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    {manifold : ClosedConnectedSmoothOrientedFourManifoldInput}
    {H2 : Type uH} [AddCommGroup H2]
    {alpha : H2}
    (source target : AdmissiblePresentation manifold H2 alpha) where
  move :
    TableTwoMove
      source.state.presentation.topology
      target.state.presentation.topology
  calculation :
    LocalCycleCalculation 𝒞 automorphism move
  compatibility :
    CancellationSafeStep calculation
      source.state.representative target.state.representative

/--
The marked-presentation calculus for one arbitrary integral class.

The class `alpha` is part of the presentation type, so a move cannot silently
change it.  `PUnit` is used only because the generic quotient layer expects a
separate marking family; all mathematical marking data already live in the
indexed presentation.
-/
noncomputable def markedPresentationTheory
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    HandlePresentationTheory where
  Presentation := AdmissiblePresentation manifold H2 alpha
  Marking := fun _ => PUnit
  ElementaryMove := fun source target =>
    MarkedMove 𝒞 automorphism source target
  transport := fun _ _ => PUnit.unit

/-- Scalar evaluation of an arbitrary-`H2` marked presentation. -/
noncomputable def markedEvaluation
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    PresentationEvaluation
      (markedPresentationTheory 𝒞 automorphism manifold H2 alpha) K where
  value := fun presentation _ =>
    presentation.value 𝒞 automorphism

/--
Every certified marked move preserves the evaluation.

This theorem works for an arbitrary additive commutative group `H2`; no
basis, rank, freeness, torsion-free, or simply-connected assumption occurs.
-/
theorem markedEvaluation_localInvariant
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    IsInvariantUnderElementaryMoves
      (markedEvaluation 𝒞 automorphism manifold H2 alpha) := by
  intro source target move _
  exact eval_sound move.calculation
    source.state.representative target.state.representative
    move.compatibility

/-- Evaluation on the quotient generated by certified arbitrary-`H2` moves. -/
noncomputable def evaluationOnKirbyClass
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2) :
    (markedPresentationTheory
      𝒞 automorphism manifold H2 alpha).KirbyClass → K :=
  (markedEvaluation 𝒞 automorphism manifold H2 alpha).descendToKirbyClass
    (markedEvaluation_localInvariant
      𝒞 automorphism manifold H2 alpha)

/-- The quotient value agrees with every displayed representative formula. -/
theorem evaluationOnKirbyClass_mk
    (𝒞 : ModularCategory (K := K) (C := C) (S := S))
    (automorphism : TensorIdentityAutomorphism C)
    (manifold : ClosedConnectedSmoothOrientedFourManifoldInput)
    (H2 : Type uH) [AddCommGroup H2]
    (alpha : H2)
    (presentation : AdmissiblePresentation manifold H2 alpha) :
    evaluationOnKirbyClass 𝒞 automorphism manifold H2 alpha
        (Quotient.mk _
          {
            presentation := presentation
            marking := PUnit.unit
          }) =
      presentation.value 𝒞 automorphism :=
  rfl

end TwistedYetter.Kirby.GeneralH2MarkedKirbyInvariance
