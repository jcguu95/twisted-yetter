import Mathlib.GroupTheory.QuotientGroup.Basic
import TwistedYetter.Kirby.StandardCapClosure

/-!
# Deriving the three-handle boundary map from the boundary movie

A standardization movie does more than determine the number of
three-handles.  The standard zero-framed unlink has a standard system of
`g` embedded two-spheres.  Transporting that sphere system backwards through
the movie gives the actual attaching spheres in the boundary of the lower
handlebody.

The cellular map

`d3 : C3 -> C2`

is then the intersection matrix between those transported attaching spheres
and the belt data of the two-handles.

This file makes that dependency directional:

`movie -> transported sphere system -> intersection numbers -> d3 -> H2`.

There is no `d3` field in `CertifiedClosedPresentation`, and there is no
independently supplied handle-chain complex.

What remains to instantiate for concrete diagrams is deliberately visible:

* transport of sphere systems for each primitive three-dimensional Kirby
  move; and
* the geometric intersection calculation against the lower two-handles.

Source boundary:

* `ref:kirby-framed-link-calculus-1978`;
* `ref:gompf-stipsicz-4-manifolds-kirby-calculus`, Sections 4.2 and 5.1.
-/

namespace TwistedYetter.Kirby.BoundaryDerivedHandleChain

open scoped BigOperators
open TwistedYetter.Kirby.BoundaryStandardization

universe uD uIso uSlide uP uSphere

/-- The free integral abelian group generated by `count` handles. -/
abbrev FreeHandleGroup (count : Nat) := Fin count → ℤ

/-- The lower cellular boundary map, determined before adding the cap. -/
structure LowerHandleBoundaryData
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus) where
  d2 :
    (lower : lowerTheory.Presentation) →
      FreeHandleGroup (lowerTheory.twoHandleCount lower) →+
        FreeHandleGroup (lowerTheory.oneHandleCount lower)

/--
Geometric sphere systems on surgery boundaries and their transport through
each primitive Kirby move.

The three move families are separate fields.  In particular, there is no
catch-all function that may silently claim transport for an unknown move.
-/
structure SphereSystemTransport
    (calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}) where
  SphereSystem : calculus.Diagram → Nat → Type uSphere
  standardSphereSystem :
    (genus : Nat) →
      SphereSystem (calculus.zeroFramedUnlink genus) genus
  framedIsotopyEquiv :
    {source target : calculus.Diagram} →
    calculus.FramedIsotopy source target →
    (genus : Nat) →
      SphereSystem source genus ≃ SphereSystem target genus
  handleSlideEquiv :
    {source target : calculus.Diagram} →
    calculus.HandleSlide source target →
    (genus : Nat) →
      SphereSystem source genus ≃ SphereSystem target genus
  stabilizationEquiv :
    (source : calculus.Diagram) →
    (sign : StabilizationSign) →
    (genus : Nat) →
      SphereSystem source genus ≃
        SphereSystem (calculus.stabilize source sign) genus

namespace SphereSystemTransport

/-- Sphere-system transport for exactly one whitelisted primitive move. -/
def elementaryEquiv
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (transport : SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus)
    {source target : calculus.Diagram}
    (move : calculus.ElementaryMove source target)
    (genus : Nat) :
    transport.SphereSystem source genus ≃
      transport.SphereSystem target genus :=
  match move with
  | .framedIsotopy witness =>
      transport.framedIsotopyEquiv witness genus
  | .handleSlide witness =>
      transport.handleSlideEquiv witness genus
  | .stabilizationBirth source sign =>
      transport.stabilizationEquiv source sign genus
  | .stabilizationDeath target sign =>
      (transport.stabilizationEquiv target sign genus).symm

/-- A full movie transports sphere systems by composition, not by an axiom. -/
def movieEquiv
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (transport : SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus)
    {source target : calculus.Diagram}
    (movie : calculus.KirbyMovie source target)
    (genus : Nat) :
    transport.SphereSystem source genus ≃
      transport.SphereSystem target genus :=
  match movie with
  | .refl _ =>
      Equiv.refl _
  | .step move =>
      transport.elementaryEquiv move genus
  | .symm movie =>
      (transport.movieEquiv movie genus).symm
  | .trans first second =>
      (transport.movieEquiv first genus).trans
        (transport.movieEquiv second genus)

/--
Pull the standard unlink sphere system back to the actual lower boundary.
-/
def attachingSphereSystem
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (transport : SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus)
    {boundaryDiagram : calculus.Diagram}
    (certificate :
      BoundaryStandardizationCertificate calculus boundaryDiagram) :
    transport.SphereSystem boundaryDiagram certificate.genus :=
  (transport.movieEquiv certificate.movie certificate.genus).symm
    (transport.standardSphereSystem certificate.genus)

end SphereSystemTransport

/--
Intersection data between transported three-handle attaching spheres and
the lower two-handle basis.

The `boundarySquared` field is the geometric fact that the resulting
intersection matrix lands in two-cycles.  It is stated on the primitive
intersection numbers, before `d3` is packaged as a homomorphism.
-/
structure AttachingSphereIntersectionTheory
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus)
    (lowerBoundary : LowerHandleBoundaryData lowerTheory)
    (sphereTransport :
      SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus) where
  intersectionNumber :
    (lower : lowerTheory.Presentation) →
    {genus : Nat} →
    sphereTransport.SphereSystem
      (lowerTheory.boundarySurgeryDiagram lower) genus →
    Fin genus →
    Fin (lowerTheory.twoHandleCount lower) →
    ℤ
  boundarySquared :
    (lower : lowerTheory.Presentation) →
    {genus : Nat} →
    (spheres :
      sphereTransport.SphereSystem
        (lowerTheory.boundarySurgeryDiagram lower) genus) →
    (coefficient : FreeHandleGroup genus) →
      lowerBoundary.d2 lower
          (fun twoHandle =>
            ∑ sphere,
              coefficient sphere *
                intersectionNumber lower spheres sphere twoHandle) =
        0

namespace AttachingSphereIntersectionTheory

/--
The map `d3` derived from the geometric intersection numbers.

It is a definition, not a field of either the presentation or the
certificate.
-/
def d3
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    {lowerBoundary : LowerHandleBoundaryData lowerTheory}
    {sphereTransport :
      SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus}
    (intersection :
      AttachingSphereIntersectionTheory
        lowerTheory lowerBoundary sphereTransport)
    (lower : lowerTheory.Presentation)
    {genus : Nat}
    (spheres :
      sphereTransport.SphereSystem
        (lowerTheory.boundarySurgeryDiagram lower) genus) :
    FreeHandleGroup genus →+
      FreeHandleGroup (lowerTheory.twoHandleCount lower) where
  toFun := fun coefficient twoHandle =>
    ∑ sphere,
      coefficient sphere *
        intersection.intersectionNumber lower spheres sphere twoHandle
  map_zero' := by
    funext twoHandle
    simp
  map_add' := by
    intro left right
    funext twoHandle
    simp [add_mul, Finset.sum_add_distrib]

theorem d2_d3_zero
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    {lowerBoundary : LowerHandleBoundaryData lowerTheory}
    {sphereTransport :
      SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus}
    (intersection :
      AttachingSphereIntersectionTheory
        lowerTheory lowerBoundary sphereTransport)
    (lower : lowerTheory.Presentation)
    {genus : Nat}
    (spheres :
      sphereTransport.SphereSystem
        (lowerTheory.boundarySurgeryDiagram lower) genus)
    (coefficient : FreeHandleGroup genus) :
    lowerBoundary.d2 lower
        (intersection.d3 lower spheres coefficient) = 0 :=
  intersection.boundarySquared lower spheres coefficient

end AttachingSphereIntersectionTheory

/-- The degree-three and degree-two part of the derived handle complex. -/
structure ClosedHandleBoundaryData (h1 h2 h3 : Nat) where
  d2 : FreeHandleGroup h2 →+ FreeHandleGroup h1
  d3 : FreeHandleGroup h3 →+ FreeHandleGroup h2
  d2_d3_zero : (coefficient : FreeHandleGroup h3) →
    d2 (d3 coefficient) = 0

namespace ClosedHandleBoundaryData

/-- The subgroup of degree-two cycles. -/
abbrev Cycles
    {h1 h2 h3 : Nat}
    (data : ClosedHandleBoundaryData h1 h2 h3) :=
  AddMonoidHom.ker data.d2

/-- The derived map from three-chains into the subgroup of two-cycles. -/
def d3ToCycles
    {h1 h2 h3 : Nat}
    (data : ClosedHandleBoundaryData h1 h2 h3) :
    FreeHandleGroup h3 →+ data.Cycles where
  toFun := fun coefficient =>
    ⟨data.d3 coefficient, data.d2_d3_zero coefficient⟩
  map_zero' := by
    apply Subtype.ext
    exact data.d3.map_zero
  map_add' := by
    intro left right
    apply Subtype.ext
    exact data.d3.map_add left right

/--
Second handle homology as cycles modulo the boundaries forced by the
transported attaching spheres.
-/
abbrev SecondHomology
    {h1 h2 h3 : Nat}
    (data : ClosedHandleBoundaryData h1 h2 h3) :=
  data.Cycles ⧸ AddMonoidHom.range data.d3ToCycles

end ClosedHandleBoundaryData

namespace CertifiedClosedPresentation

/--
Build the degree-two handle homology data from a boundary certificate.

Every input other than the lower diagram is global geometric semantics:
sphere transport for each primitive move and intersection calculation.
There is no per-presentation `d3` escape hatch.
-/
def derivedHandleBoundaryData
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    (lowerBoundary : LowerHandleBoundaryData lowerTheory)
    (sphereTransport :
      SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus)
    (intersection :
      AttachingSphereIntersectionTheory
        lowerTheory lowerBoundary sphereTransport)
    (presentation : CertifiedClosedPresentation lowerTheory) :
    ClosedHandleBoundaryData
      (lowerTheory.oneHandleCount presentation.lower)
      (lowerTheory.twoHandleCount presentation.lower)
      presentation.boundaryCertificate.genus where
  d2 := lowerBoundary.d2 presentation.lower
  d3 := intersection.d3 presentation.lower
    (sphereTransport.attachingSphereSystem
      presentation.boundaryCertificate)
  d2_d3_zero := fun coefficient =>
    intersection.d2_d3_zero presentation.lower
      (sphereTransport.attachingSphereSystem
        presentation.boundaryCertificate)
      coefficient

/-- The boundary-derived marked group used by a certified evaluator. -/
abbrev derivedSecondHomology
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    (lowerBoundary : LowerHandleBoundaryData lowerTheory)
    (sphereTransport :
      SphereSystemTransport.{uD, uIso, uSlide, uSphere} calculus)
    (intersection :
      AttachingSphereIntersectionTheory
        lowerTheory lowerBoundary sphereTransport)
    (presentation : CertifiedClosedPresentation lowerTheory) :=
  (derivedHandleBoundaryData
    lowerBoundary sphereTransport intersection presentation).SecondHomology

end CertifiedClosedPresentation

end TwistedYetter.Kirby.BoundaryDerivedHandleChain
