import TwistedYetter.Kirby.ComponentRibbonIsotopy
import TwistedYetter.Kirby.CanonicalTraceLocality
import TwistedYetter.Kirby.CanonicalTraceDiagramDeterminism

/-!
# Canonical cancellation ribbon movies

This module builds the local ribbon diagrams for cancelling adjacent handle
pairs directly from typed Morse-slice event windows.  It contains no category,
evaluator, scalar equality, or topology axiom.

The first obligation is the isolated zero-framed unknot used by a 2--3
birth/death.  A later presentation-level compiler must still prove that the
serialized cancellation window is this exact local script.
-/

namespace TwistedYetter.Kirby.CanonicalCancellationRibbonMovies

open TwistedYetter.Kirby.CanonicalKirbyTrace
open TwistedYetter.Kirby.ComponentRibbonDiagram
open TwistedYetter.Kirby.ComponentRibbonIsotopy
open TwistedYetter.Kirby.Presentation

/-- The positive strand in a canonical isolated component. -/
def positive (positiveId componentId : String) : StrandState :=
  positiveStrand positiveId componentId

/-- The negative strand in a canonical isolated component. -/
def negative (negativeId componentId : String) : StrandState :=
  negativeStrand negativeId componentId

/-- Canonical isolated birth window for one zero-framed component. -/
def zeroFramedBirthWindow
    (birthEventId componentId positiveId negativeId : String) :
    EventWindow
      (.birth birthEventId componentId positiveId negativeId 0)
      []
      [positive positiveId componentId, negative negativeId componentId] :=
  FreeTemplates.zeroFramedBirthWindow
    birthEventId componentId positiveId negativeId

/-- Canonical isolated death window for the same oriented component. -/
def zeroFramedDeathWindow
    (deathEventId componentId positiveId negativeId : String) :
    EventWindow
      (.death deathEventId componentId positiveId negativeId)
      [positive positiveId componentId, negative negativeId componentId]
      [] :=
  FreeTemplates.zeroFramedDeathWindow
    deathEventId componentId positiveId negativeId

/-- Free diagram generated by the exact isolated birth/death script. -/
def zeroFramedEventDiagram
    (birthEventId deathEventId componentId positiveId negativeId : String) :
    ComponentDiagram .unit .unit :=
  FreeTemplates.zeroFramedEventDiagram
    birthEventId deathEventId componentId positiveId negativeId

/--
The exact isolated event script is a zero-framed unknot in the free ribbon
grammar.
-/
theorem zeroFramedEventDiagram_isotopy
    (birthEventId deathEventId componentId positiveId negativeId : String) :
    GeneratedIsotopy
      (zeroFramedEventDiagram birthEventId deathEventId
        componentId positiveId negativeId)
      (ComponentDiagram.zeroFramedUnknot componentId) := by
  exact .step
    (.zeroFramedEventNormalization
      birthEventId deathEventId componentId positiveId negativeId)

/--
The exact isolated six-event script is the positive Hopf pair used by a
cancelling one--two handle pair.
-/
theorem oneTwoHopfEventDiagram_isotopy
    (twoBirthId dottedBirthId firstCrossingId secondCrossingId
      dottedDeathId twoDeathId dottedId twoHandleId
      dottedPositiveId dottedNegativeId twoPositiveId twoNegativeId :
      String) :
    GeneratedIsotopy
      (FreeTemplates.oneTwoHopfEventDiagram
        twoBirthId dottedBirthId firstCrossingId secondCrossingId
        dottedDeathId twoDeathId dottedId twoHandleId
        dottedPositiveId dottedNegativeId twoPositiveId twoNegativeId)
      (ComponentDiagram.oneTwoHopfPair dottedId twoHandleId) := by
  exact .step
    (.oneTwoHopfEventNormalization
      twoBirthId dottedBirthId firstCrossingId secondCrossingId
      dottedDeathId twoDeathId dottedId twoHandleId
      dottedPositiveId dottedNegativeId twoPositiveId twoNegativeId)

end TwistedYetter.Kirby.CanonicalCancellationRibbonMovies
