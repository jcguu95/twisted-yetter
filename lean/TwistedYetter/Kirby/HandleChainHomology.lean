import Mathlib.Algebra.Category.ModuleCat.Abelian
import Mathlib.Algebra.Homology.Homotopy
import Mathlib.Algebra.Homology.ShortComplex.Abelian
import TwistedYetter.Kirby.KirbyCancellation

/-!
# Handle-chain homology for marked Kirby presentations

This module replaces a handwritten `H2` equivalence by data from which the
equivalence is forced:

* a chain complex of `ℤ`-modules;
* explicit bases in degrees zero through four, indexed by handles;
* a chain homotopy equivalence between two such complexes; and
* Mathlib's induced isomorphism on second homology.

The binding of a particular boundary matrix to a Kirby diagram remains a
separate content-addressed input.  Once that input is supplied, however, the
map on `H2` is no longer an independent field or proposition.
-/

namespace TwistedYetter.Kirby.HandleChainHomology

open CategoryTheory
open CategoryTheory.Limits
open TwistedYetter.Kirby.KirbyCancellation
open TwistedYetter.Kirby.Presentation

noncomputable section

/-- The free integral module generated by `count` handles. -/
abbrev HandleModule (count : Nat) :=
  ModuleCat.of ℤ (Fin count → ℤ)

/--
A content-addressed handle chain complex with explicit handle bases.

The five isomorphisms are data, not rank assertions: they exhibit the chain
group in degree `i` as the free integral module on the index-`i` handles.
-/
structure HandleChainModel (counts : HandleCounts) where
  complex : ChainComplex (ModuleCat ℤ) ℕ
  degreeZeroBasis : complex.X 0 ≅ HandleModule counts.h0
  degreeOneBasis : complex.X 1 ≅ HandleModule counts.h1
  degreeTwoBasis : complex.X 2 ≅ HandleModule counts.h2
  degreeThreeBasis : complex.X 3 ≅ HandleModule counts.h3
  degreeFourBasis : complex.X 4 ≅ HandleModule counts.h4
  higherDegreeZero :
    (degree : Nat) → 5 ≤ degree → IsZero (complex.X degree)
  chainSnapshotHash : String
  chain_snapshot_hash_shape :
    RawPresentation.sha256Shape chainSnapshotHash = true
  boundaryMatrixCertificateHash : String
  boundary_matrix_certificate_hash_shape :
    RawPresentation.sha256Shape boundaryMatrixCertificateHash = true
  basisCertificateHash : String
  basis_certificate_hash_shape :
    RawPresentation.sha256Shape basisCertificateHash = true

namespace HandleChainModel

/-- Second homology of the concrete handle chain complex. -/
abbrev SecondHomology {counts : HandleCounts}
    (model : HandleChainModel counts) :=
  model.complex.homology 2

end HandleChainModel

/--
Concrete chain-level data relating two handle decompositions.

There is deliberately no separately supplied homology map.  It is derived
below from `homotopyEquiv`.
-/
structure HandleChainEquivalence
    {sourceCounts targetCounts : HandleCounts}
    (source : HandleChainModel sourceCounts)
    (target : HandleChainModel targetCounts) where
  homotopyEquiv : HomotopyEquiv source.complex target.complex
  chainMapSnapshotHash : String
  chain_map_snapshot_hash_shape :
    RawPresentation.sha256Shape chainMapSnapshotHash = true
  sourceChainHash : String
  source_chain_hash_sound :
    sourceChainHash = source.chainSnapshotHash
  targetChainHash : String
  target_chain_hash_sound :
    targetChainHash = target.chainSnapshotHash

namespace HandleChainEquivalence

/-- The linear equivalence on `H₂` forced by the chain homotopy equivalence. -/
noncomputable def secondHomologyLinearEquiv
    {sourceCounts targetCounts : HandleCounts}
    {source : HandleChainModel sourceCounts}
    {target : HandleChainModel targetCounts}
    (equivalence : HandleChainEquivalence source target) :
    source.SecondHomology ≃ₗ[ℤ] target.SecondHomology :=
  (equivalence.homotopyEquiv.toHomologyIso 2).toLinearEquiv

/-- The underlying type equivalence on second homology. -/
noncomputable def secondHomologyEquiv
    {sourceCounts targetCounts : HandleCounts}
    {source : HandleChainModel sourceCounts}
    {target : HandleChainModel targetCounts}
    (equivalence : HandleChainEquivalence source target) :
    source.SecondHomology ≃ target.SecondHomology :=
  equivalence.secondHomologyLinearEquiv.toEquiv

/-- The additive equivalence underlying the induced linear equivalence. -/
noncomputable def secondHomologyAddEquiv
    {sourceCounts targetCounts : HandleCounts}
    {source : HandleChainModel sourceCounts}
    {target : HandleChainModel targetCounts}
    (equivalence : HandleChainEquivalence source target) :
    source.SecondHomology ≃+ target.SecondHomology :=
  equivalence.secondHomologyLinearEquiv.toAddEquiv

/-- Identity chain data induces the identity map on second homology. -/
theorem secondHomologyEquiv_refl_apply
    {counts : HandleCounts}
    (model : HandleChainModel counts)
    (chainMapSnapshotHash : String)
    (hashShape :
      RawPresentation.sha256Shape chainMapSnapshotHash = true)
    (alpha : model.SecondHomology) :
    (HandleChainEquivalence.secondHomologyEquiv
      ({
        homotopyEquiv := HomotopyEquiv.refl model.complex
        chainMapSnapshotHash := chainMapSnapshotHash
        chain_map_snapshot_hash_shape := hashShape
        sourceChainHash := model.chainSnapshotHash
        source_chain_hash_sound := rfl
        targetChainHash := model.chainSnapshotHash
        target_chain_hash_sound := rfl
      } : HandleChainEquivalence model model)) alpha = alpha := by
  change (HomologicalComplex.homologyMap (𝟙 model.complex) 2) alpha = alpha
  rw [HomologicalComplex.homologyMap_id]
  rfl

end HandleChainEquivalence

end

end TwistedYetter.Kirby.HandleChainHomology
