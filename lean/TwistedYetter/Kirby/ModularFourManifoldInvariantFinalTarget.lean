import TwistedYetter.Fusion.EGNOPremodularModular
import TwistedYetter.Kirby.BoundaryStandardization

/-!
# Presentation-level Kirby descent with a clean mathematical boundary

This module contains the presentation-quotient layer of the descent argument.
The paper-facing statement whose public input is exactly
`(X, alpha : H2(X; Z))` is in
`HomologicalFourManifoldInvariantFinalTarget`.  This lower layer deliberately
contains no hashes, source locators, execution certificates, or presentation
compilers.

There are three separate layers:

1. `HandlePresentationTheory` is the mathematical calculus of marked handle
   presentations and elementary moves.
2. `KirbyClass` is the quotient generated by those moves.  A locally invariant
   evaluation descends to this quotient by a theorem proved below.
3. A marked-four-manifold realization, move soundness, presentation
   existence, and Kirby--Cerf completeness are four separate topology inputs.
   Lean derives the equivalence of quotient spaces from them.

The omitted geometry of 3-handles is not represented by a count in this
module.  It is supplied by the independent boundary-movie and standard-cap
route in `BoundaryStandardization` and `StandardCapClosure`.

The repository's content-addressed presentations and compilers remain useful
implementation evidence.  They are intentionally absent from this theorem
surface.
-/

namespace TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget

open TwistedYetter.Kirby.BoundaryStandardization

universe uK uP uM uMove uX uXHom

/--
The mathematical data of a marked handle-presentation calculus.

`Presentation` is abstract on purpose.  A concrete implementation may store a
Kirby diagram, handle counts, and a handle chain complex, but audit metadata is
not part of this interface.
-/
structure HandlePresentationTheory where
  Presentation : Type uP
  Marking : Presentation → Type uM
  ElementaryMove : Presentation → Presentation → Type uMove
  transport :
    {source target : Presentation} →
      ElementaryMove source target →
      Marking source → Marking target

namespace HandlePresentationTheory

/-- A presentation together with one class in its own handle-chain marking. -/
structure MarkedPresentation
    (theory : HandlePresentationTheory.{uP, uM, uMove}) where
  presentation : theory.Presentation
  marking : theory.Marking presentation

/--
A proof-relevant marked Kirby movie.

This lives in `Type`, not `Prop`, because its steps are later interpreted as
actual diffeomorphisms.  Erasing the movie to mere existence happens only in
`KirbyEquivalent`.
-/
inductive KirbyMovie
    (theory : HandlePresentationTheory.{uP, uM, uMove}) :
    theory.MarkedPresentation → theory.MarkedPresentation →
      Type (max uP (max uM uMove))
  | refl (marked : theory.MarkedPresentation) :
      KirbyMovie theory marked marked
  | elementary
      {source target : theory.Presentation}
      (move : theory.ElementaryMove source target)
      (marking : theory.Marking source) :
      KirbyMovie theory
        ⟨source, marking⟩
        ⟨target, theory.transport move marking⟩
  | symm
      {left right : theory.MarkedPresentation}
      (movie : KirbyMovie theory left right) :
      KirbyMovie theory right left
  | trans
      {left middle right : theory.MarkedPresentation}
      (first : KirbyMovie theory left middle)
      (second : KirbyMovie theory middle right) :
      KirbyMovie theory left right

/-- The quotient relation remembers that at least one typed movie exists. -/
def KirbyEquivalent
    (theory : HandlePresentationTheory.{uP, uM, uMove})
    (left right : theory.MarkedPresentation) : Prop :=
  Nonempty (KirbyMovie theory left right)

/-- The generated Kirby relation is an equivalence relation by construction. -/
theorem kirbyEquivalent_equivalence
    (theory : HandlePresentationTheory.{uP, uM, uMove}) :
    Equivalence theory.KirbyEquivalent where
  refl := fun marked => ⟨KirbyMovie.refl marked⟩
  symm := fun relation => by
    rcases relation with ⟨movie⟩
    exact ⟨KirbyMovie.symm movie⟩
  trans := fun first second => by
    rcases first with ⟨firstMovie⟩
    rcases second with ⟨secondMovie⟩
    exact ⟨KirbyMovie.trans firstMovie secondMovie⟩

/-- Marked handle presentations modulo the generated Kirby relation. -/
def KirbyClass
    (theory : HandlePresentationTheory.{uP, uM, uMove}) :=
  Quotient {
    r := theory.KirbyEquivalent
    iseqv := theory.kirbyEquivalent_equivalence
  }

end HandlePresentationTheory

/--
A scalar evaluation of marked handle presentations.

This is mathematical data only.  Reproducibility records for a concrete
implementation belong in a separate evidence artifact.
-/
structure PresentationEvaluation
    (theory : HandlePresentationTheory.{uP, uM, uMove})
    (K : Type uK) where
  value :
    (presentation : theory.Presentation) →
      theory.Marking presentation → K

/-- The exact local theorem that the categorical calculation must prove. -/
def IsInvariantUnderElementaryMoves
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {K : Type uK}
    (evaluation : PresentationEvaluation theory K) : Prop :=
  ∀ {source target : theory.Presentation}
    (move : theory.ElementaryMove source target)
    (marking : theory.Marking source),
      evaluation.value source marking =
        evaluation.value target (theory.transport move marking)

namespace PresentationEvaluation

/-- Evaluate a marked presentation before passing to the quotient. -/
def markedValue
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {K : Type uK}
    (evaluation : PresentationEvaluation theory K)
    (marked : theory.MarkedPresentation) : K :=
  evaluation.value marked.presentation marked.marking

/-- Local move invariance implies equality along one proof-relevant movie. -/
theorem respectsKirbyMovie
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {K : Type uK}
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation)
    {left right : theory.MarkedPresentation}
    (movie : theory.KirbyMovie left right) :
    evaluation.markedValue left = evaluation.markedValue right := by
  induction movie with
  | refl =>
      rfl
  | elementary move marking =>
      exact localInvariant move marking
  | symm _ inductionHypothesis =>
      exact inductionHypothesis.symm
  | trans _ _ firstIH secondIH =>
      exact firstIH.trans secondIH

/--
Local move invariance therefore respects the proof-irrelevant quotient
relation.
-/
theorem respectsKirbyEquivalent
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {K : Type uK}
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation)
    {left right : theory.MarkedPresentation}
    (relation : theory.KirbyEquivalent left right) :
    evaluation.markedValue left = evaluation.markedValue right := by
  rcases relation with ⟨movie⟩
  exact evaluation.respectsKirbyMovie localInvariant movie

/-- The evaluation induced on marked Kirby-equivalence classes. -/
def descendToKirbyClass
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {K : Type uK}
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation) :
    theory.KirbyClass → K :=
  Quotient.lift evaluation.markedValue
    (fun _ _ relation =>
      evaluation.respectsKirbyEquivalent localInvariant relation)

/-- The descended value agrees with the original presentation formula. -/
theorem descendToKirbyClass_mk
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {K : Type uK}
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation)
    (marked : theory.MarkedPresentation) :
    evaluation.descendToKirbyClass localInvariant
        (Quotient.mk _ marked) =
      evaluation.markedValue marked :=
  rfl

end PresentationEvaluation

/--
Geometric meaning of each marked handle presentation.

This contains no classification claim.  It only fixes the target type of
marked closed oriented smooth four-manifolds and the realization map.
-/
structure MarkedFourManifoldRealization
    (theory : HandlePresentationTheory.{uP, uM, uMove}) where
  MarkedClosedOrientedSmoothFourManifold : Type uX
  orientedDiffeomorphism :
    OrientedDiffeomorphismGroupoid.{uX, uXHom}
      MarkedClosedOrientedSmoothFourManifold
  realize :
    theory.MarkedPresentation →
      MarkedClosedOrientedSmoothFourManifold

/--
Every elementary marked Kirby move realizes an actual oriented
diffeomorphism.
-/
structure ElementaryMoveGeometricSoundness
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    (realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory) where
  diffeomorphism :
    {source target : theory.Presentation} →
    (move : theory.ElementaryMove source target) →
    (marking : theory.Marking source) →
      realization.orientedDiffeomorphism.Hom
        (realization.realize ⟨source, marking⟩)
        (realization.realize
          ⟨target, theory.transport move marking⟩)

/-- Every marked closed four-manifold admits a marked handle presentation. -/
structure MarkedPresentationExistence
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    (realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory) where
  presentation :
    realization.MarkedClosedOrientedSmoothFourManifold →
      theory.MarkedPresentation
  realizationDiffeomorphism :
    (manifold : realization.MarkedClosedOrientedSmoothFourManifold) →
      realization.orientedDiffeomorphism.Hom
        (realization.realize (presentation manifold))
        manifold

/--
Kirby--Cerf completeness, stated independently of move soundness and
presentation existence.

It says that a diffeomorphism between the realizations of two marked
presentations produces a movie in the generated relation.
-/
structure MarkedKirbyCerfCompleteness
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    (realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory) where
  connected :
    (left right : theory.MarkedPresentation) →
    realization.orientedDiffeomorphism.Hom
      (realization.realize left) (realization.realize right) →
      theory.KirbyEquivalent left right

namespace MarkedFourManifoldRealization

/-- Two marked manifolds are equivalent when an oriented diffeomorphism exists. -/
def Diffeomorphic
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    (realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory)
    (left right : realization.MarkedClosedOrientedSmoothFourManifold) :
    Prop :=
  Nonempty (realization.orientedDiffeomorphism.Hom left right)

/-- Existence of an oriented diffeomorphism is an equivalence relation. -/
theorem diffeomorphic_equivalence
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    (realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory) :
    Equivalence realization.Diffeomorphic where
  refl := fun manifold =>
    ⟨realization.orientedDiffeomorphism.identity manifold⟩
  symm := fun relation => by
    rcases relation with ⟨diffeomorphism⟩
    exact
      ⟨realization.orientedDiffeomorphism.inverse diffeomorphism⟩
  trans := fun first second => by
    rcases first with ⟨firstDiffeomorphism⟩
    rcases second with ⟨secondDiffeomorphism⟩
    exact
      ⟨realization.orientedDiffeomorphism.compose
        firstDiffeomorphism secondDiffeomorphism⟩

/-- Marked closed four-manifolds modulo oriented diffeomorphism. -/
def DiffeomorphismClass
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    (realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory) :=
  Quotient {
    r := realization.Diffeomorphic
    iseqv := realization.diffeomorphic_equivalence
  }

end MarkedFourManifoldRealization

namespace ElementaryMoveGeometricSoundness

/-- A proof-relevant Kirby movie realizes an oriented diffeomorphism. -/
def kirbyMovieDiffeomorphism
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    (soundness : ElementaryMoveGeometricSoundness realization)
    {left right : theory.MarkedPresentation}
    (movie : theory.KirbyMovie left right) :
    realization.orientedDiffeomorphism.Hom
      (realization.realize left) (realization.realize right) :=
  match movie with
  | .refl marked =>
      realization.orientedDiffeomorphism.identity
        (realization.realize marked)
  | .elementary move marking =>
      soundness.diffeomorphism move marking
  | .symm movie =>
      realization.orientedDiffeomorphism.inverse
        (soundness.kirbyMovieDiffeomorphism movie)
  | .trans first second =>
      realization.orientedDiffeomorphism.compose
        (soundness.kirbyMovieDiffeomorphism first)
        (soundness.kirbyMovieDiffeomorphism second)

/-- Mere movie existence implies diffeomorphism existence. -/
theorem kirbyEquivalentDiffeomorphic
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    (soundness : ElementaryMoveGeometricSoundness realization)
    {left right : theory.MarkedPresentation}
    (relation : theory.KirbyEquivalent left right) :
    realization.Diffeomorphic
      (realization.realize left) (realization.realize right) := by
  rcases relation with ⟨movie⟩
  exact ⟨soundness.kirbyMovieDiffeomorphism movie⟩

/-- Realization induces a map from Kirby classes to diffeomorphism classes. -/
def kirbyClassToDiffeomorphismClass
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    (soundness : ElementaryMoveGeometricSoundness realization) :
    theory.KirbyClass → realization.DiffeomorphismClass :=
  Quotient.lift
    (fun marked => Quotient.mk _ (realization.realize marked))
    (fun _ _ relation =>
      Quotient.sound
        (soundness.kirbyEquivalentDiffeomorphic relation))

end ElementaryMoveGeometricSoundness

namespace MarkedPresentationExistence

/-- Chosen presentations induce the reverse map on quotient spaces. -/
def diffeomorphismClassToKirbyClass
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    (existence : MarkedPresentationExistence realization)
    (completeness : MarkedKirbyCerfCompleteness realization) :
    realization.DiffeomorphismClass → theory.KirbyClass :=
  Quotient.lift
    (fun manifold => Quotient.mk _ (existence.presentation manifold))
    (fun left right relation => by
      apply Quotient.sound
      rcases relation with ⟨diffeomorphism⟩
      exact completeness.connected
        (existence.presentation left)
        (existence.presentation right)
        (realization.orientedDiffeomorphism.compose
          (existence.realizationDiffeomorphism left)
          (realization.orientedDiffeomorphism.compose
            diffeomorphism
            (realization.orientedDiffeomorphism.inverse
              (existence.realizationDiffeomorphism right)))))

end MarkedPresentationExistence

/--
Lean derives the classification equivalence from the four separate topology
ingredients.  No caller supplies the equivalence itself.
-/
def kirbyClassEquivDiffeomorphismClass
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    (soundness : ElementaryMoveGeometricSoundness realization)
    (existence : MarkedPresentationExistence realization)
    (completeness : MarkedKirbyCerfCompleteness realization) :
    theory.KirbyClass ≃ realization.DiffeomorphismClass where
  toFun := soundness.kirbyClassToDiffeomorphismClass
  invFun := existence.diffeomorphismClassToKirbyClass completeness
  left_inv := by
    intro kirbyClass
    refine Quotient.inductionOn kirbyClass ?_
    intro marked
    apply Quotient.sound
    exact completeness.connected
      (existence.presentation (realization.realize marked))
      marked
      (existence.realizationDiffeomorphism
        (realization.realize marked))
  right_inv := by
    intro diffeomorphismClass
    refine Quotient.inductionOn diffeomorphismClass ?_
    intro manifold
    apply Quotient.sound
    exact
      ⟨existence.realizationDiffeomorphism manifold⟩

/-- The descended scalar on oriented-diffeomorphism classes. -/
def invariantOnDiffeomorphismClass
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    {K : Type uK}
    (soundness : ElementaryMoveGeometricSoundness realization)
    (existence : MarkedPresentationExistence realization)
    (completeness : MarkedKirbyCerfCompleteness realization)
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation) :
    realization.DiffeomorphismClass → K :=
  evaluation.descendToKirbyClass localInvariant ∘
    (kirbyClassEquivDiffeomorphismClass
      soundness existence completeness).symm

/-- The actual function on marked closed oriented smooth four-manifolds. -/
def fourManifoldInvariant
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    {K : Type uK}
    (soundness : ElementaryMoveGeometricSoundness realization)
    (existence : MarkedPresentationExistence realization)
    (completeness : MarkedKirbyCerfCompleteness realization)
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation) :
    realization.MarkedClosedOrientedSmoothFourManifold → K :=
  fun manifold =>
    invariantOnDiffeomorphismClass
      soundness existence completeness evaluation localInvariant
      (Quotient.mk _ manifold)

/-- The resulting function is constant on oriented diffeomorphism classes. -/
theorem fourManifoldInvariant_diffeomorphism_invariant
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    {K : Type uK}
    (soundness : ElementaryMoveGeometricSoundness realization)
    (existence : MarkedPresentationExistence realization)
    (completeness : MarkedKirbyCerfCompleteness realization)
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation)
    {left right :
      realization.MarkedClosedOrientedSmoothFourManifold}
    (diffeomorphism :
      realization.orientedDiffeomorphism.Hom left right) :
    fourManifoldInvariant
        soundness existence completeness evaluation localInvariant left =
      fourManifoldInvariant
        soundness existence completeness evaluation localInvariant right := by
  apply congrArg
    (invariantOnDiffeomorphismClass
      soundness existence completeness evaluation localInvariant)
  exact Quotient.sound ⟨diffeomorphism⟩

/--
Pulling the four-manifold invariant back along realization recovers the
original marked presentation formula.
-/
theorem fourManifoldInvariant_on_presentation
    {theory : HandlePresentationTheory.{uP, uM, uMove}}
    {realization :
      MarkedFourManifoldRealization.{uP, uM, uMove, uX, uXHom} theory}
    {K : Type uK}
    (soundness : ElementaryMoveGeometricSoundness realization)
    (existence : MarkedPresentationExistence realization)
    (completeness : MarkedKirbyCerfCompleteness realization)
    (evaluation : PresentationEvaluation theory K)
    (localInvariant : IsInvariantUnderElementaryMoves evaluation)
    (marked : theory.MarkedPresentation) :
    fourManifoldInvariant
        soundness existence completeness evaluation localInvariant
        (realization.realize marked) =
      evaluation.markedValue marked := by
  change
    evaluation.descendToKirbyClass localInvariant
        ((kirbyClassEquivDiffeomorphismClass
          soundness existence completeness).symm
          ((kirbyClassEquivDiffeomorphismClass
            soundness existence completeness)
            (Quotient.mk _ marked))) =
      evaluation.markedValue marked
  rw [(kirbyClassEquivDiffeomorphismClass
    soundness existence completeness).symm_apply_apply]
  rfl

end TwistedYetter.Kirby.ModularFourManifoldInvariantFinalTarget
