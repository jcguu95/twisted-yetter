import TwistedYetter.Kirby.KirbyCancellation

/-!
# Certified boundary standardization for closed four-dimensional handlebodies

A lower Kirby diagram describes the zero-, one-, and two-handlebody
`W_{\le 2}`.  It does not describe a closed four-manifold until its boundary
has been identified with a standard connected sum

`U_g = #^g (S^1 x S^2)`.

This file makes that identification visible.  A certificate is a typed finite
three-dimensional Kirby movie from the actual boundary-surgery diagram to the
`g`-component zero-framed unlink.  Its primitive moves are exactly framed
isotopy, handle slide, and addition or removal of an isolated `+1`- or
`-1`-framed unknot.

Stabilization is essential.  Requiring a movie made only of handle slides
would silently assume Generalized Property R.

This module contains no hashes, no Boolean "represents a manifold" field, no
independently supplied three-handle count, and no independently supplied
handle-chain complex.

Source boundary:

* `ref:kirby-framed-link-calculus-1978`, Theorem 1;
* `ref:gompf-stipsicz-4-manifolds-kirby-calculus`, Section 5.1.
-/

namespace TwistedYetter.Kirby.BoundaryStandardization

open TwistedYetter.Kirby.KirbyCancellation

universe uD uIso uSlide uM uHom uP

/-- Sign of the isolated framed unknot used in a Kirby stabilization. -/
inductive StabilizationSign
  | positive
  | negative
  deriving Repr, BEq, DecidableEq

/--
The mathematical syntax of integral framed surgery diagrams in `S^3`.

`FramedIsotopy` and `HandleSlide` are witness types, not propositions stored
inside a certificate.  A concrete implementation must define their actual
diagrammatic data.  Soundness is supplied separately by `SurgerySemantics`.
-/
structure FramedSurgeryDiagramTheory where
  Diagram : Type uD
  FramedIsotopy : Diagram → Diagram → Type uIso
  HandleSlide : Diagram → Diagram → Type uSlide
  stabilize : Diagram → StabilizationSign → Diagram
  zeroFramedUnlink : Nat → Diagram

namespace FramedSurgeryDiagramTheory

/--
One primitive move in Kirby's framed-link surgery calculus.

The death constructor is kept explicit instead of asking a serializer to
encode it as an informal inverse step.
-/
inductive ElementaryMove
    (calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}) :
    calculus.Diagram → calculus.Diagram →
      Type (max uD (max uIso uSlide))
  | framedIsotopy
      {source target : calculus.Diagram}
      (witness : calculus.FramedIsotopy source target) :
      ElementaryMove calculus source target
  | handleSlide
      {source target : calculus.Diagram}
      (witness : calculus.HandleSlide source target) :
      ElementaryMove calculus source target
  | stabilizationBirth
      (source : calculus.Diagram)
      (sign : StabilizationSign) :
      ElementaryMove calculus source (calculus.stabilize source sign)
  | stabilizationDeath
      (target : calculus.Diagram)
      (sign : StabilizationSign) :
      ElementaryMove calculus (calculus.stabilize target sign) target

/-- A typed finite movie generated by the complete primitive whitelist. -/
inductive KirbyMovie
    (calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}) :
    calculus.Diagram → calculus.Diagram →
      Type (max uD (max uIso uSlide))
  | refl (diagram : calculus.Diagram) :
      KirbyMovie calculus diagram diagram
  | step
      {source target : calculus.Diagram}
      (move : calculus.ElementaryMove source target) :
      KirbyMovie calculus source target
  | symm
      {source target : calculus.Diagram}
      (movie : KirbyMovie calculus source target) :
      KirbyMovie calculus target source
  | trans
      {source middle target : calculus.Diagram}
      (first : KirbyMovie calculus source middle)
      (second : KirbyMovie calculus middle target) :
      KirbyMovie calculus source target

end FramedSurgeryDiagramTheory

/--
A small groupoid whose morphisms are to be instantiated by
orientation-preserving diffeomorphisms.

The groupoid laws are included so later arguments may not use arbitrary
unstructured arrows while calling them diffeomorphisms.
-/
structure OrientedDiffeomorphismGroupoid (Object : Type uM) where
  Hom : Object → Object → Type uHom
  identity : (object : Object) → Hom object object
  compose :
    {source middle target : Object} →
      Hom source middle → Hom middle target → Hom source target
  inverse :
    {source target : Object} →
      Hom source target → Hom target source
  identity_compose :
    {source target : Object} →
      (morphism : Hom source target) →
        compose (identity source) morphism = morphism
  compose_identity :
    {source target : Object} →
      (morphism : Hom source target) →
        compose morphism (identity target) = morphism
  compose_assoc :
    {a b c d : Object} →
      (first : Hom a b) →
      (second : Hom b c) →
      (third : Hom c d) →
        compose (compose first second) third =
          compose first (compose second third)
  inverse_compose :
    {source target : Object} →
      (morphism : Hom source target) →
        compose (inverse morphism) morphism = identity target
  compose_inverse :
    {source target : Object} →
      (morphism : Hom source target) →
        compose morphism (inverse morphism) = identity source

/--
The geometric interpretation of the primitive framed-link moves.

This is deliberately separate from diagram syntax.  It is the exact point at
which Kirby's surgery theorem is used.  No evaluator appears here.
-/
structure SurgerySemantics
    (calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}) where
  ThreeManifold : Type uM
  orientedDiffeomorphism :
    OrientedDiffeomorphismGroupoid.{uM, uHom} ThreeManifold
  surgery : calculus.Diagram → ThreeManifold
  standardBoundary : Nat → ThreeManifold
  framedIsotopySound :
    {source target : calculus.Diagram} →
      calculus.FramedIsotopy source target →
        orientedDiffeomorphism.Hom (surgery source) (surgery target)
  handleSlideSound :
    {source target : calculus.Diagram} →
      calculus.HandleSlide source target →
        orientedDiffeomorphism.Hom (surgery source) (surgery target)
  stabilizationSound :
    (source : calculus.Diagram) →
    (sign : StabilizationSign) →
      orientedDiffeomorphism.Hom
        (surgery source)
        (surgery (calculus.stabilize source sign))
  zeroFramedUnlinkSound :
    (genus : Nat) →
      orientedDiffeomorphism.Hom
        (surgery (calculus.zeroFramedUnlink genus))
        (standardBoundary genus)

namespace SurgerySemantics

/-- Every primitive move induces its orientation-preserving surgery map. -/
def elementaryDiffeomorphism
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (semantics : SurgerySemantics.{uD, uIso, uSlide, uM, uHom} calculus)
    {source target : calculus.Diagram}
    (move : calculus.ElementaryMove source target) :
    semantics.orientedDiffeomorphism.Hom
      (semantics.surgery source) (semantics.surgery target) :=
  match move with
  | .framedIsotopy witness =>
      semantics.framedIsotopySound witness
  | .handleSlide witness =>
      semantics.handleSlideSound witness
  | .stabilizationBirth source sign =>
      semantics.stabilizationSound source sign
  | .stabilizationDeath target sign =>
      semantics.orientedDiffeomorphism.inverse
        (semantics.stabilizationSound target sign)

/-- A full movie induces a boundary diffeomorphism by typed composition. -/
def movieDiffeomorphism
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (semantics : SurgerySemantics.{uD, uIso, uSlide, uM, uHom} calculus)
    {source target : calculus.Diagram}
    (movie : calculus.KirbyMovie source target) :
    semantics.orientedDiffeomorphism.Hom
      (semantics.surgery source) (semantics.surgery target) :=
  match movie with
  | .refl diagram =>
      semantics.orientedDiffeomorphism.identity
        (semantics.surgery diagram)
  | .step move =>
      semantics.elementaryDiffeomorphism move
  | .symm movie =>
      semantics.orientedDiffeomorphism.inverse
        (semantics.movieDiffeomorphism movie)
  | .trans first second =>
      semantics.orientedDiffeomorphism.compose
        (semantics.movieDiffeomorphism first)
        (semantics.movieDiffeomorphism second)

end SurgerySemantics

/--
Proof-bearing recognition of one lower handlebody boundary.

The genus is accepted only together with a movie whose target is exactly the
zero-framed unlink of that genus.
-/
structure BoundaryStandardizationCertificate
    (calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide})
    (boundaryDiagram : calculus.Diagram) where
  genus : Nat
  movie :
    calculus.KirbyMovie boundaryDiagram
      (calculus.zeroFramedUnlink genus)

namespace BoundaryStandardizationCertificate

/-- The number of three-handles is derived from the certified standard end. -/
def threeHandleCount
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {boundaryDiagram : calculus.Diagram}
    (certificate :
      BoundaryStandardizationCertificate calculus boundaryDiagram) : Nat :=
  certificate.genus

/--
The boundary identification induced by the actual movie, followed by the
standard interpretation of the zero-framed unlink.
-/
def boundaryDiffeomorphism
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {boundaryDiagram : calculus.Diagram}
    (semantics : SurgerySemantics.{uD, uIso, uSlide, uM, uHom} calculus)
    (certificate :
      BoundaryStandardizationCertificate calculus boundaryDiagram) :
    semantics.orientedDiffeomorphism.Hom
      (semantics.surgery boundaryDiagram)
      (semantics.standardBoundary certificate.genus) :=
  semantics.orientedDiffeomorphism.compose
    (semantics.movieDiffeomorphism certificate.movie)
    (semantics.zeroFramedUnlinkSound certificate.genus)

theorem threeHandleCount_eq_genus
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {boundaryDiagram : calculus.Diagram}
    (certificate :
      BoundaryStandardizationCertificate calculus boundaryDiagram) :
    certificate.threeHandleCount = certificate.genus :=
  rfl

end BoundaryStandardizationCertificate

/--
The lower-handle input before any three- or four-handle completion.

The boundary surgery diagram and the one- and two-handle counts are functions of
the presentation.  They cannot be changed independently inside a closure
certificate.
-/
structure LowerHandlebodyTheory
    (calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}) where
  Presentation : Type uP
  boundarySurgeryDiagram : Presentation → calculus.Diagram
  oneHandleCount : Presentation → Nat
  twoHandleCount : Presentation → Nat

/--
A lower handlebody together with actual proof that its boundary is standard.

There is no `h3` field.  There is no independently supplied closed manifold
name.  The closed completion is constructed in `StandardCapClosure`.
-/
structure CertifiedClosedPresentation
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    (lowerTheory : LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus) where
  lower : lowerTheory.Presentation
  boundaryCertificate :
    BoundaryStandardizationCertificate calculus
      (lowerTheory.boundarySurgeryDiagram lower)

namespace CertifiedClosedPresentation

/-- Handle counts forced by the lower diagram and the standard cap. -/
def handleCounts
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    (presentation : CertifiedClosedPresentation lowerTheory) :
    HandleCounts where
  h0 := 1
  h1 := lowerTheory.oneHandleCount presentation.lower
  h2 := lowerTheory.twoHandleCount presentation.lower
  h3 := presentation.boundaryCertificate.genus
  h4 := 1

theorem h0_eq_one
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    (presentation : CertifiedClosedPresentation lowerTheory) :
    presentation.handleCounts.h0 = 1 :=
  rfl

theorem h3_eq_boundary_genus
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    (presentation : CertifiedClosedPresentation lowerTheory) :
    presentation.handleCounts.h3 =
      presentation.boundaryCertificate.genus :=
  rfl

theorem h4_eq_one
    {calculus : FramedSurgeryDiagramTheory.{uD, uIso, uSlide}}
    {lowerTheory :
      LowerHandlebodyTheory.{uD, uIso, uSlide, uP} calculus}
    (presentation : CertifiedClosedPresentation lowerTheory) :
    presentation.handleCounts.h4 = 1 :=
  rfl

end CertifiedClosedPresentation

end TwistedYetter.Kirby.BoundaryStandardization
